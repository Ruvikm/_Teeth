/* pages/clock/clock.wxss */

/* 滑块页面 */
.tab{float: left; width: 50%;text-align: center;padding: 10rpx 0; }
.topTabSwiper{border-top: 1px solid #fffafa; border-bottom: 1px solid #ccc; zoom: 1;}
.topTabSwiper:after{content: ""; clear: both;display: block;}
.tabBorer{border-bottom: 1px solid #ff7c7c; color: #ff7c7c;}
.swiper{width: 100%;}
.body{
  background-color: #fafafa;
  width: 100%;
  height: 100%;
}

/* 打卡图片 */
#p_1{
  background: rgba(0,0,0,0);
  top:15rpx;
  right:120rpx;
  width:9%;
  height:7%;
  position: absolute;
}

#p_2{
  background: rgba(0,0,0,0);
    top: 8rpx;
    right:120rpx;
    width: 10%;
    height: 8%;
    position: absolute;
}


/* 打卡文字 */
#check{
    top: 20rpx;
    right:35rpx;
    position: absolute;
}

#check_1{
    top: 28rpx;
