/* 开始刷牙按钮 */
.b{
  display: flex;
  flex-direction:column;
  justify-content: center;
  height: 150rpx;
  width: 100%;
  color:blue;
  bottom: 150rpx;
  position: absolute;
}

.a{
  display: flex;
  flex-direction:column;
  justify-content: center;
  height: 150rpx;
  width: 100%;
  color:blue;
  bottom: 150rpx;
  position: absolute;
}


/* 圆环 */
.canvass {
  width: 200px;
  height: 200px;
  background: rgba(0,0,0,0);
  text-align: center;
  line-height: 200px;
  color: #49f;
  font-size: 50rpx;
  margin: 0 auto;
  top: 50px;
}

.c {
  width: 200px;
  height: 200px;
  background: rgba(0,0,0,0);
  text-align: center;
  line-height: 200px;
  color: #49f;
  font-size: 50rpx;
