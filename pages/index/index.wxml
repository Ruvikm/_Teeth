<!--pages/index/index.wxml-->

<van-search
    value="{{ value }}"
    show-action
    placeholder="请输入搜索关键词"
    bind:change="onChange"
    bind:search="onSearch"
    bind:cancel="onCancel"
    bind:clear="onClear"
  />

<view class="imagepage">
  <image bindtap="chat" mode="widthFix" src="https://7275-ruvik-333-1301153827.tcb.qcloud.la/specialist.png?sign=92f28c3d4ca287995ef1beeb8e691064&t=1581083424" class="expert" ></image>
  <image is-link bindtap="showBasic" mode="widthFix" src="https://7275-ruvik-333-1301153827.tcb.qcloud.la/question.png?sign=7f3f884b7120ba84aa838f6bd642c589&t=1581074959" class="investigation" ></image>
  <van-popup
    show="{{ show.basic }}"
    bind:close="hideBasic"
  >
    <text class="tip">请截图识别二维码</text>
    <image  class="survey" src="https://7275-ruvik-333-1301153827.tcb.qcloud.la/%E9%97%AE%E5%8D%B7%E8%B0%83%E6%9F%A5.png?sign=7658e10024a2e49f7155115ce9ca89c5&t=1581161527" />
  </van-popup>
</view>
<van-divider content-position="center" class="Divider">动态</van-divider>
