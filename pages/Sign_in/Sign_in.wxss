/* pages/Sign_in/Sign_in.wxss */
.all{
  margin-top: 20px;
}

.all .bar{
  display: flex;
  flex-direction: row;
  justify-content: space-between;

}

.all .bar image{
  width: 55rpx;
  height: 55rpx;
}

.all .week{
  display: flex;
  flex-direction:row;
  justify-content: space-around;
  padding: 18rpx;
  margin: 20rpx;
  border-radius: 20px;
  
}

.all .days{
  margin: 20rpx;
  padding: 8rpx;
  border-radius: 10px;
}

.all .columns{
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.all .columns .rows{
   display: flex;
   flex-direction: row;
   justify-content: space-between;
}

.all .days .columns .rows .cell{
  width: 84rpx;
  height: 88rpx;
  margin: 5rpx;
  text-align: center;
  border-radius: 80%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}